      "baseline": 10,
      "containerId": null,
      "originalText": "Evidence Reasoning & Contradiction Resolution Layer",
      "lineHeight": 1.3
    },
    {
      "id": "s4_body",
      "type": "text",
      "x": 550,
      "y": 905,
      "width": 633.3599999999999,
      "height": 78.0,
      "angle": 0,
      "strokeColor": "#0c4a6e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 500087,
      "version": 1,
      "versionNonce": 500088,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1787503055608,
      "link": null,
      "locked": false,
      "text": "\u2022 Core Thesis: \"High risk score cannot automatically BLOCK without behavioral confirmation\"\n\u2022 Weighs directional evidence vectors: Direction::{Supports, Contradicts}\n\u2022 Computes evidence_confidence; demands high certainty before blocking\n\u2022 Escalates high-risk / low-confidence scenarios to REVIEW (Human-in-the-Loop)\n\u2022 Zero false-positive friction on innocent customers (0 of 324 legitimate users blocked)",
      "fontSize": 12,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 9,
      "containerId": null,
      "originalText": "\u2022 Core Thesis: \"High risk score cannot automatically BLOCK without behavioral confirmation\"\n\u2022 Weighs directional evidence vectors: Direction::{Supports, Contradicts}\n\u2022 Computes evidence_confidence; demands high certainty before blocking\n\u2022 Escalates high-risk / low-confidence scenarios to REVIEW (Human-in-the-Loop)\n\u2022 Zero false-positive friction on innocent customers (0 of 324 legitimate users blocked)",
      "lineHeight": 1.3
    },
