      "isDeleted": false,
      "boundElements": [],
      "updated": 1787503055608,
      "link": null,
      "locked": false,
      "text": "\u2022 Statistical Z-score anomaly detection against historical agent behavior baselines\n\u2022 Intent Mismatch Scorer: NLP cross-check of declared_intent text vs action_type + amount\n\u2022 Behavioral drift measurement over sliding temporal windows\n\u2022 Output: Bounded composite risk score \u2208 [0.0, 1.0]",
      "fontSize": 12,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 9,
      "containerId": null,
      "originalText": "\u2022 Statistical Z-score anomaly detection against historical agent behavior baselines\n\u2022 Intent Mismatch Scorer: NLP cross-check of declared_intent text vs action_type + amount\n\u2022 Behavioral drift measurement over sliding temporal windows\n\u2022 Output: Bounded composite risk score \u2208 [0.0, 1.0]",
