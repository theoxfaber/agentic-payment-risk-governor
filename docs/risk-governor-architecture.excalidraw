      "boundElements": [],
      "updated": 1787503055608,
      "link": null,
      "locked": false,
      "text": "\u2022 Auto-allow ceiling: \u2264 \u20b950,000 | Human approval threshold: > \u20b9150,000 | Hard block cap: > \u20b9500,000\n\u2022 Per-agent velocity limits & hourly window rate counters\n\u2022 Country & merchant domain scope allowlists / blocklists\n\u2022 Fast-path immediate rejection before heavy scoring pipeline",
      "fontSize": 12,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 9,
