# Razorpay TEST-mode API keys (dashboard → Settings → API Keys → generate TEST keys).
# Omit both to run governor-server with MockGateway (moves no money).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# API key required on every /v1/* route (X-API-Key or Authorization: Bearer).
# Omit to have an ephemeral key generated and printed at startup.
GOVERNOR_API_KEY=

# Separate human-approval key. When set, POST /v1/decisions/:id/approve
# requires this key — the submit key cannot self-approve its own REVIEWs.
# Unset = single-key mode (dev/demo). Always set in production.
GOVERNOR_REVIEW_KEY=

# Fail-closed boot flags (production): refuse to start with volatile memory
# or a mock money-movement gateway instead of failing silently.
# REQUIRE_PG=1 requires DATABASE_URL; REQUIRE_GATEWAY=1 requires live keys.
REQUIRE_PG=
REQUIRE_GATEWAY=

# LLM-backed intent extraction (OpenAI-compatible). Omit LLM_API_KEY to use
# the deterministic heuristic extractor. Extracted claims are evidence only —
# they can raise a risk score, never grant an allow.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# Distributed mode (docker compose up -d)
NATS_URL=nats://127.0.0.1:4222
DATABASE_URL=postgres://governor:governor@127.0.0.1:5432/governor

# Webhook signature verification (X-Razorpay-Signature HMAC-SHA256)
WEBHOOK_SECRET=

# Log filter (tracing EnvFilter syntax)
RUST_LOG=info

# Port for governor-server
PORT=8080

# Demo entity seeding. In-memory backend always seeds (dev/demo). With
# Postgres, seeding happens ONLY when this is true/1 — production DBs must
# not silently inherit demo agents or default merchant policies.
SEED_DEMO=

# External anchor for tamper-evident audit chain: HMAC-SHA256 of chain head.
# When set, GET /v1/audit/verify and /v1/audit/anchor return hmac_sha256 so an
# external sink can detect a full-chain rewrite (which hash-chaining alone
# cannot — see docs/BUGS.md #17). Without it the chain is tamper-evident but
# not externally anchored. In prod, REVOKE UPDATE/DELETE ON audit_records FROM app_role.
AUDIT_SIGNING_KEY=

# Risk-score reference distribution for drift monitoring: JSON array of 5
# bucket proportions ([0,.2),[.2,.4),[.4,.6),[.6,.8),[.8,1]). When set,
# /metrics exports risk_governor_score_psi vs this reference.
SCORE_REFERENCE_JSON=[0.55,0.25,0.12,0.06,0.02]
