# Razorpay TEST-mode API keys (dashboard → Settings → API Keys → generate TEST keys).
# Omit both to run governor-server with MockGateway (moves no money).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# API key required on every /v1/* route (X-API-Key or Authorization: Bearer).
# Omit to have an ephemeral key generated and printed at startup.
GOVERNOR_API_KEY=

# LLM-backed intent extraction (OpenAI-compatible). Omit LLM_API_KEY to use
# the deterministic heuristic extractor. Extracted claims are evidence only —
# they can raise a risk score, never grant an allow.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# Distributed mode (docker compose up -d)
NATS_URL=nats://127.0.0.1:4222
DATABASE_URL=postgres://governor:governor@127.0.0.1:5432/governor

# Webhook signature verification (X-Razorpay-Signature HMAC-SHA256)
WEBHOOK_SECRET=

# Log filter (tracing EnvFilter syntax)
RUST_LOG=info

# Port for governor-server
PORT=8080
